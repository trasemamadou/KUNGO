# Copier ce fichier en `.env` (non versionné) et renseigner les valeurs réelles
# avant `docker compose -f docker-compose.prod.yml up -d`.

# Images (poussées par la CI vers un registre, ex: GHCR)
BACKEND_IMAGE=ghcr.io/kungo/backend:latest
FRONTEND_IMAGE=ghcr.io/kungo/frontend:latest

# Base de données
DB_NAME=kungo
DB_USER=kungo
DB_PASSWORD=change_me_strong_password

# JWT — 256 bits minimum, généré aléatoirement (ex: openssl rand -base64 48)
JWT_SECRET=change_me_use_a_long_random_secret

# URLs publiques
FRONTEND_URL=https://kungo.app
API_BASE_URL=https://api.kungo.app/api/v1
APP_CORS_ALLOWED_ORIGINS=https://kungo.app

# SMTP (email transactionnel)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_FROM=no-reply@kungo.app

# Paiement
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
